build _deps/crow-build/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = C:\windows\system32\cmd.exe /C "cd /D C:\Users\hp\Downloads\scanly-repo\scanly\build\_deps\crow-build && C:\Strawberry\c\bin\ctest.exe --force-new-ctest-process "
  DESC = Running tests...
  pool = console
  restat = 1

build _deps/crow-build/test: phony _deps/crow-build/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build _deps/crow-build/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\windows\system32\cmd.exe /C "cd /D C:\Users\hp\Downloads\scanly-repo\scanly\build\_deps\crow-build && C:\Strawberry\c\bin\cmake.exe -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build _deps/crow-build/edit_cache: phony _deps/crow-build/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build _deps/crow-build/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\windows\system32\cmd.exe /C "cd /D C:\Users\hp\Downloads\scanly-repo\scanly\build\_deps\crow-build && C:\Strawberry\c\bin\cmake.exe --regenerate-during-build -SC:\Users\hp\Downloads\scanly-repo\scanly -BC:\Users\hp\Downloads\scanly-repo\scanly\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build _deps/crow-build/rebuild_cache: phony _deps/crow-build/CMakeFiles/rebuild_cache.util


#############################################
# Custom command for _deps\crow-build\CMakeFiles\uninstall

build _deps/crow-build/CMakeFiles/uninstall | ${cmake_ninja_workdir}_deps/crow-build/CMakeFiles/uninstall: CUSTOM_COMMAND
  COMMAND = C:\windows\system32\cmd.exe /C "cd /D C:\Users\hp\Downloads\scanly-repo\scanly\build\_deps\crow-build && C:\Strawberry\c\bin\cmake.exe -P C:/Users/hp/Downloads/scanly-repo/scanly/build/_deps/crow-build/cmake_uninstall.cmake"

